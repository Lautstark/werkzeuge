{
  "name": "@lautstark/werkzeuge",
  "version": "2.1.0",
  "type": "module",
  "description": "The small tools the Lautstark AAC products had each written for themselves: a download that actually starts, a change notifier, a German filename, a size somebody can read, the link that opens a published Sammlung, and the ⋯ menu a box carries in its corner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lautstark/werkzeuge.git"
  },
  "keywords": [
    "aac",
    "download",
    "blob",
    "transliteration",
    "german"
  ],
  "sideEffects": false,
  "exports": {
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "default": "./dist/bytes.js"
    },
    "./changed": {
      "types": "./dist/changed.d.ts",
      "default": "./dist/changed.js"
    },
    "./download": {
      "types": "./dist/download.d.ts",
      "default": "./dist/download.js"
    },
    "./filename": {
      "types": "./dist/filename.d.ts",
      "default": "./dist/filename.js"
    },
    "./reactive-text": {
      "svelte": "./src/reactive-text.svelte.ts",
      "default": "./src/reactive-text.svelte.ts"
    },
    "./sammlung": {
      "types": "./dist/sammlung.d.ts",
      "default": "./dist/sammlung.js"
    },
    "./svelte/MoreMenu": {
      "svelte": "./svelte/MoreMenu.svelte",
      "default": "./svelte/MoreMenu.svelte"
    }
  },
  "files": [
    "dist",
    "src",
    "svelte",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "happy-dom": "^20.11.6",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
