{
  "name": "@lautstark/werkzeuge",
  "version": "1.2.0",
  "type": "module",
  "description": "The small tools the Lautstark AAC products had each written for themselves: a download that actually starts, a change notifier, a German filename, a size somebody can read, and the link that opens a published Sammlung.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lautstark/werkzeuge.git"
  },
  "keywords": [
    "aac",
    "download",
    "blob",
    "transliteration",
    "german"
  ],
  "sideEffects": false,
  "exports": {
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "default": "./dist/bytes.js"
    },
    "./changed": {
      "types": "./dist/changed.d.ts",
      "default": "./dist/changed.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./download": {
      "types": "./dist/download.d.ts",
      "default": "./dist/download.js"
    },
    "./filename": {
      "types": "./dist/filename.d.ts",
      "default": "./dist/filename.js"
    },
    "./sammlung": {
      "types": "./dist/sammlung.d.ts",
      "default": "./dist/sammlung.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "happy-dom": "^20.11.6",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
